#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LINK_SCRIPT="$ROOT_DIR/scripts/link-home"
DIAGNOSTICS_SCRIPT="$ROOT_DIR/scripts/setup"
DRY_RUN=0
CONFIG_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --config-only) CONFIG_ONLY=1 ;;
    -h|--help)
      cat <<'USAGE'
Usage: ./setup --config-only [--dry-run]

Configure the user home from this repository. The setup never installs packages,
uses sudo, changes system files, or runs system hooks.
USAGE
      exit 0
      ;;
    *)
      printf '[setup-entry] Unknown argument: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

if [[ "$CONFIG_ONLY" -ne 1 ]]; then
  printf '[setup-entry] Continuing in config-only mode; use --config-only for the stable interface.\n'
fi

diagnostic_args=(--config-only)
link_args=()
if [[ "$DRY_RUN" -eq 1 ]]; then
  diagnostic_args+=(--dry-run)
  link_args+=(--dry-run)
fi

"$DIAGNOSTICS_SCRIPT" "${diagnostic_args[@]}"
if [[ "$DRY_RUN" -eq 1 ]]; then
  "$LINK_SCRIPT" --dry-run
else
  "$LINK_SCRIPT"
fi
