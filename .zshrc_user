# ~/.zshrc_user
# -------------------------------------------------------------
# Real-user interactive customizations
# Everything in this file is skipped when $CLAUDECODE==1 (e.g., CI or
# automated terminals).
# -------------------------------------------------------------

# OS CLI completions
fpath=("$HOME/.zsh/completions" $fpath)

# ---- zoxide --------------------------------------------------
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init --cmd cd zsh)"

  # Ensure __zoxide_z helper exists (fallback when completion misfires)
  if ! type __zoxide_z &>/dev/null; then
    __zoxide_z() {
      if [[ "$#" -eq 0 ]]; then
        builtin cd ~
      elif [[ "$#" -eq 1 ]] && { [[ -d "$1" ]] || [[ "$1" = '-' ]] || [[ "$1" =~ ^[-+][0-9]$ ]]; }; then
        builtin cd "$1"
      else
        local dst
        dst="$(command zoxide query --exclude "$(pwd)" -- "$@")" && builtin cd "$dst"
      fi
    }
  fi

  # fzf-tab preview for zoxide completions
  zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'
fi

################ PROMPT ################
# ! >>>>>>>>> starship
if [[ "${TERM:-}" != "dumb" ]] && command -v starship &>/dev/null; then
  dotfiles_load_generated_completion starship starship init zsh --print-full-init
fi

################ ZSTYLE ################
# Base
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:*' path-expand false

################ ZINIT PLUGINS ################
# Base
dotfiles_zinit_light zsh-users/zsh-syntax-highlighting
dotfiles_zinit_light zsh-users/zsh-completions
dotfiles_zinit_light zsh-users/zsh-autosuggestions
dotfiles_zinit_light Aloxaf/fzf-tab

# Custom
# dotfiles_zinit_light marlonrichert/zsh-autocomplete
#dotfiles_zinit_light jeffreytse/zsh-vi-mode
