# Public RustDesk OSS client configuration.
# Environment variables with the same name but without the REPO_ prefix override
# these values at deployment time.

# Preferred: export the server config from Settings -> Network in a configured
# RustDesk client. The string contains the ID server, relay server and public key.
RUSTDESK_REPO_CONFIG_STRING=''

# Fallback when no exported config string is available.
RUSTDESK_REPO_ID_SERVER=''
RUSTDESK_REPO_RELAY_SERVER=''
RUSTDESK_REPO_PUBLIC_KEY=''
