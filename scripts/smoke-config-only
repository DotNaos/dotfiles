#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_HOME="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-config-only.XXXXXX")"
PYTHON_CACHE="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-python-cache.XXXXXX")"
trap 'rm -rf "$TEST_HOME" "$PYTHON_CACHE"' EXIT

forbidden_pattern='apt-get|brew install|winget install|sudo (apt|cp|mv|sh)|scripts/system|/etc/'
if rg -n "$forbidden_pattern" \
  "$ROOT_DIR/setup" "$ROOT_DIR/scripts/setup" "$ROOT_DIR/scripts/link-home" "$ROOT_DIR/scripts/render-configs"; then
  printf 'config-only guard failed: privileged or package installation call found\n' >&2
  exit 1
fi

HOME="$TEST_HOME" DOTFILES_CONTEXT_HOME="$TEST_HOME" PYTHONPYCACHEPREFIX="$PYTHON_CACHE" \
  "$ROOT_DIR/setup" --config-only --dry-run

if find "$TEST_HOME" -mindepth 1 -print -quit | grep -q .; then
  printf 'config-only dry-run created files in the isolated home\n' >&2
  exit 1
fi

HOME="$TEST_HOME" DOTFILES_CONTEXT_HOME="$TEST_HOME" PYTHONPYCACHEPREFIX="$PYTHON_CACHE" \
  "$ROOT_DIR/setup" --config-only

test -L "$TEST_HOME/.zshrc"
test -L "$TEST_HOME/.ssh/config"
python3 - "$TEST_HOME/.ssh" <<'PY_MODE'
import os
import stat
import sys

mode = stat.S_IMODE(os.stat(sys.argv[1]).st_mode)
if mode != 0o700:
    raise SystemExit(f"unexpected ~/.ssh mode: {mode:o}")
PY_MODE
grep -Fxq '    CanonicalDomains vpn.os-home.net' "$TEST_HOME/.ssh/config"
if command -v ssh >/dev/null 2>&1; then
  ssh -F "$TEST_HOME/.ssh/config" -G github.com >/dev/null
fi
test -L "$TEST_HOME/.config/zed"
test -f "$TEST_HOME/.local/state/dotfiles/rendered/.codex/config.toml"
printf 'config-only smoke passed\n'
