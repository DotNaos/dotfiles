#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_HOME="${HOME}"
DRY_RUN=0
BACKUP_ROOT=""
BACKUP_ROOT_ANNOUNCED=0
RENDER_ROOT=""
ONLY=""

# shellcheck source=scripts/lib/context.sh
source "$ROOT_DIR/scripts/lib/context.sh"

LINK_ITEMS=(
  ".jj"
  ".ssh/config"
  ".tmux.conf"
  ".zsh"
  ".zsh_aliases"
  ".zshenv"
  ".zshrc"
  ".zshrc.d"
  ".zshrc_functions"
  ".zshrc_user"
)

MANAGED_CONFIG_ITEMS=(
  "git"
  "ghostty"
  "nvim"
  "zed"
)

usage() {
  cat <<USAGE
Usage: ./scripts/link-home [--dry-run] [--home PATH] [--render-root PATH] [--only codex]

Options:
  --dry-run     Print actions without executing
  --home PATH   Link into a different home directory
  --render-root PATH   Override the rendered config output directory
  --only codex  Render and link only the managed Codex files
  -h, --help    Show this help
USAGE
}

log() {
  printf '[link-home] %s\n' "$*"
}

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run: $*"
  else
    eval "$*"
  fi
}

ensure_parent_dir() {
  local target_path="$1"
  run "mkdir -p '$(dirname "$target_path")'"
}

rendered_config_root() {
  if [[ -n "$RENDER_ROOT" ]]; then
    printf '%s\n' "$RENDER_ROOT"
    return 0
  fi

  printf '%s/.local/state/dotfiles/rendered\n' "$TARGET_HOME"
}

init_backup_root() {
  [[ -n "$BACKUP_ROOT" ]] && return 0
  BACKUP_ROOT="$TARGET_HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
}

announce_backup_root() {
  if [[ "$BACKUP_ROOT_ANNOUNCED" -eq 1 ]]; then
    return 0
  fi

  log "Backing up replaced paths into $BACKUP_ROOT"
  BACKUP_ROOT_ANNOUNCED=1
}

backup_conflicting_path() {
  local target_path="$1"
  local backup_path

  [[ -e "$target_path" || -L "$target_path" ]] || return 0

  init_backup_root
  backup_path="$BACKUP_ROOT/${target_path#"$TARGET_HOME"/}"

  announce_backup_root
  ensure_parent_dir "$backup_path"
  run "mv '$target_path' '$backup_path'"
  log "Backed up ${target_path#"$TARGET_HOME"/}"
}

is_managed_config_item() {
  local item="$1"
  local managed

  for managed in "${MANAGED_CONFIG_ITEMS[@]}"; do
    [[ "$managed" == "$item" ]] && return 0
  done

  return 1
}

link_source_path() {
  local source_path="$1"
  local target_path="$2"
  local label="$3"

  ensure_parent_dir "$target_path"

  if [[ -L "$target_path" ]]; then
    local current_target
    current_target="$(readlink "$target_path")"
    if [[ "$current_target" == "$source_path" ]]; then
      log "Already linked: $label"
      return 0
    fi
  fi

  if [[ -e "$target_path" || -L "$target_path" ]]; then
    backup_conflicting_path "$target_path"
  fi

  run "ln -sfn '$source_path' '$target_path'"
  log "Linked $label"
}

render_managed_configs() {
  local render_script="$ROOT_DIR/scripts/render-configs"
  local render_args=("--home" "$TARGET_HOME" "--render-root" "$(rendered_config_root)")

  [[ -x "$render_script" ]] || return 0

  if [[ "$DRY_RUN" -eq 1 ]]; then
    render_args=("--dry-run" "${render_args[@]}")
  fi

  if [[ "$ONLY" == "codex" ]]; then
    render_args+=("--only" "codex")
  fi

  "$render_script" "${render_args[@]}"
}

link_raw_config_tree() {
  local source_root="$ROOT_DIR/.config"
  local target_root="$TARGET_HOME/.config"
  local source_path relative_path target_path

  [[ -d "$source_root" ]] || return 0

  run "mkdir -p '$target_root'"

  while IFS= read -r source_path; do
    relative_path="${source_path#"$source_root"/}"
    if is_managed_config_item "$relative_path"; then
      log "Skipping raw .config/$relative_path because it is context-rendered."
      continue
    fi
    target_path="$target_root/$relative_path"
    link_source_path "$source_path" "$target_path" ".config/$relative_path"
  done < <(find "$source_root" -mindepth 1 -maxdepth 1 | sort)
}

link_rendered_config_tree() {
  local item source_path target_path
  local source_root

  source_root="$(rendered_config_root)/.config"
  run "mkdir -p '$TARGET_HOME/.config'"

  for item in "${MANAGED_CONFIG_ITEMS[@]}"; do
    source_path="$source_root/$item"
    target_path="$TARGET_HOME/.config/$item"

    if [[ "$DRY_RUN" -ne 1 && ! -e "$source_path" && ! -L "$source_path" ]]; then
      log "Skipping missing rendered config: .config/$item"
      continue
    fi

    link_source_path "$source_path" "$target_path" ".config/$item"
  done
}

link_rendered_codex_files() {
  local item source_path target_path
  local source_root target_root

  source_root="$(rendered_config_root)/.codex"
  target_root="$TARGET_HOME/.codex"
  run "mkdir -p '$target_root'"

  for item in "AGENTS.md" "config.toml"; do
    source_path="$source_root/$item"
    target_path="$target_root/$item"

    if [[ "$DRY_RUN" -ne 1 && ! -e "$source_path" && ! -L "$source_path" ]]; then
      log "Skipping missing rendered Codex file: .codex/$item"
      continue
    fi

    link_source_path "$source_path" "$target_path" ".codex/$item"
  done
}

link_item() {
  local relative_path="$1"
  local source_path="$ROOT_DIR/$relative_path"
  local target_path="$TARGET_HOME/$relative_path"

  if [[ ! -e "$source_path" ]]; then
    log "Skipping missing source: $relative_path"
    return 0
  fi

  ensure_parent_dir "$target_path"
  if [[ "$relative_path" == .ssh/* ]]; then
    run "chmod 700 '$TARGET_HOME/.ssh'"
  fi

  if [[ -L "$target_path" ]]; then
    local current_target
    current_target="$(readlink "$target_path")"
    if [[ "$current_target" == "$source_path" ]]; then
      log "Already linked: $relative_path"
      return 0
    fi
  fi

  if [[ -e "$target_path" || -L "$target_path" ]]; then
    backup_conflicting_path "$target_path"
  fi

  run "ln -sfn '$source_path' '$target_path'"
  log "Linked $relative_path"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --home)
      TARGET_HOME="${2:-}"
      shift 2
      ;;
    --render-root)
      RENDER_ROOT="${2:-}"
      shift 2
      ;;
    --only)
      ONLY="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$TARGET_HOME" ]]; then
  log "Target home must not be empty."
  exit 1
fi

if [[ -n "$ONLY" && "$ONLY" != "codex" ]]; then
  log "Invalid --only value: $ONLY"
  usage
  exit 1
fi

export DOTFILES_CONTEXT_HOME="$TARGET_HOME"
dotfiles_load_context

log "Context: platform=$DOTFILES_PLATFORM role=$DOTFILES_ROLE mode=$DOTFILES_MODE shell=$DOTFILES_SHELL"
render_managed_configs

if [[ "$ONLY" == "codex" ]]; then
  link_rendered_codex_files
  log "Done."
  exit 0
fi

link_raw_config_tree
link_rendered_config_tree
link_rendered_codex_files

for item in "${LINK_ITEMS[@]}"; do
  link_item "$item"
done

log "Done."
