#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=0

log() {
  printf '[system-macos] %s\n' "$*"
}

is_macos() {
  [[ "${OSTYPE:-}" == darwin* ]]
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: scripts/system/macos [--dry-run]

Applies macOS system tweaks for dotfiles:
  - Enable Touch ID for sudo by inserting pam_tid.so into /etc/pam.d/sudo

Options:
  --dry-run   Print actions without applying changes
  -h, --help  Show this help
USAGE
      exit 0
      ;;
    *)
      log "Unknown argument: $1"
      exit 1
      ;;
  esac
done

if ! is_macos; then
  log "Not running on macOS; skipping system tweaks."
  exit 0
fi

pam_file="/etc/pam.d/sudo"
touchid_line="auth       sufficient     pam_tid.so"

if [[ ! -f "$pam_file" ]]; then
  log "sudo pam config not found at $pam_file. Skipping Touch ID setup."
  exit 0
fi

if sudo grep -Eq '^auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so' "$pam_file"; then
  log "Touch ID already enabled for sudo."
  exit 0
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
  log "Would prepend Touch ID stanza to $pam_file"
  exit 0
fi

tmp_file="$(mktemp)"
cleanup() {
  sudo rm -f "$tmp_file" "${tmp_file}.new"
}
trap cleanup EXIT

if ! sudo cp "$pam_file" "$tmp_file"; then
  log "Failed to copy $pam_file. Cannot enable Touch ID."
  exit 1
fi

if sudo sh -c "printf '%s\n' \"$touchid_line\" | cat - \"$tmp_file\" > \"${tmp_file}.new\""; then
  if sudo mv "${tmp_file}.new" "$pam_file"; then
    log "Enabled Touch ID for sudo in $pam_file."
  else
    log "Failed to install updated sudo pam config."
    exit 1
  fi
else
  log "Failed to prepare Touch ID sudo pam config."
  exit 1
fi
