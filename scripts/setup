#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRY_RUN=0

# shellcheck source=scripts/lib/context.sh
source "$ROOT_DIR/scripts/lib/context.sh"

usage() {
  cat <<'USAGE'
Usage: ./scripts/setup [--config-only] [--dry-run]

Options:
  --config-only  Configure the user home; retained for direct callers
  --dry-run      Print diagnostics without changing the user home
  -h, --help     Show this help
USAGE
}

log() {
  printf '[setup] %s\n' "$*"
}

check_prerequisites() {
  local command_name
  local missing=()

  for command_name in bash find git ln mkdir python3 sed sort; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      missing+=("$command_name")
    fi
  done

  if [[ "${#missing[@]}" -eq 0 ]]; then
    log "Configuration prerequisites are available."
  else
    log "Missing configuration prerequisites: ${missing[*]}"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config-only|--dry-run)
      [[ "$1" == "--dry-run" ]] && DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

dotfiles_load_context
log "Context: platform=$DOTFILES_PLATFORM role=$DOTFILES_ROLE mode=$DOTFILES_MODE shell=$DOTFILES_SHELL"
check_prerequisites
if [[ "$DRY_RUN" -eq 1 ]]; then
  log "dry-run: no user configuration changes will be made"
fi
