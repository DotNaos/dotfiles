#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETUP_SCRIPT="$ROOT_DIR/scripts/setup"
LINK_SCRIPT="$ROOT_DIR/scripts/link-home"

# shellcheck source=scripts/lib/context.sh
source "$ROOT_DIR/scripts/lib/context.sh"

DRY_RUN=0
EXPLICIT_MODE=0
ARGS=()

log() {
  printf '[setup-entry] %s\n' "$*"
}

has_sudo_access() {
  if ! command -v sudo >/dev/null 2>&1; then
    return 1
  fi

  sudo -n true >/dev/null 2>&1
}

has_apt_get() {
  command -v apt-get >/dev/null 2>&1
}

for arg in "$@"; do
  if [[ "$arg" == "--dry-run" ]]; then
    DRY_RUN=1
  fi

  if [[ "$arg" == "--rootless" || "$arg" == "--only" ]]; then
    EXPLICIT_MODE=1
  fi

  ARGS+=("$arg")
done

dotfiles_load_context

if [[ "$EXPLICIT_MODE" -eq 0 ]]; then
  case "$DOTFILES_PLATFORM" in
    wsl)
      if has_apt_get && has_sudo_access; then
        ARGS+=("--only" "wsl")
      else
        ARGS+=("--only" "wsl" "--rootless")
      fi
      ;;
    linux)
      if has_apt_get && has_sudo_access; then
        ARGS+=("--only" "linux")
      else
        ARGS+=("--only" "linux" "--rootless")
      fi
      ;;
  esac
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
  "$LINK_SCRIPT" --dry-run
else
  "$LINK_SCRIPT"
fi

exec "$SETUP_SCRIPT" "${ARGS[@]}"
