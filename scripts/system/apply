#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
DRY_RUN=0
TARGET_PLATFORM=""

# shellcheck source=scripts/lib/context.sh
source "$ROOT_DIR/scripts/lib/context.sh"

usage() {
  cat <<'USAGE'
Usage: ./scripts/system/apply [--platform macos|linux|wsl] [--dry-run]

Options:
  --platform VALUE   Override the platform hook selection
  --dry-run          Print actions without applying them
  -h, --help         Show this help
USAGE
}

log() {
  printf '[system-apply] %s\n' "$*"
}

run_hook_dir() {
  local hook_dir="$1"
  local hook_file

  [[ -d "$hook_dir" ]] || return 0
  log "Using hooks from ${hook_dir#"$ROOT_DIR"/}"

  for hook_file in "$hook_dir"/*; do
    [[ -f "$hook_file" && -x "$hook_file" ]] || continue
    if [[ "$DRY_RUN" -eq 1 ]]; then
      "$hook_file" --dry-run
    else
      "$hook_file"
    fi
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform)
      TARGET_PLATFORM="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

dotfiles_load_context

if [[ -n "$TARGET_PLATFORM" ]]; then
  DOTFILES_PLATFORM="$TARGET_PLATFORM"
  export DOTFILES_PLATFORM
fi

log "Context: platform=$DOTFILES_PLATFORM role=$DOTFILES_ROLE mode=$DOTFILES_MODE shell=$DOTFILES_SHELL"

run_hook_dir "$ROOT_DIR/scripts/system/hooks/base"
run_hook_dir "$ROOT_DIR/scripts/system/hooks/platform/$DOTFILES_PLATFORM"
run_hook_dir "$ROOT_DIR/scripts/system/hooks/role/$DOTFILES_ROLE"
run_hook_dir "$ROOT_DIR/scripts/system/hooks/mode/$DOTFILES_MODE"
run_hook_dir "$ROOT_DIR/scripts/system/hooks/shell/$DOTFILES_SHELL"
