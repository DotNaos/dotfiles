#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL_DIR="$ROOT_DIR/install"

ONLY=""
DRY_RUN=0
ROOTLESS=0
SYSTEM_PROFILE="${DOTFILES_SYSTEM_PROFILE:-client}"

usage() {
  cat <<USAGE
Usage: ./scripts/setup [--only macos|linux|wsl] [--rootless] [--dry-run]

Options:
  --only <platform>   Restrict install steps to one platform
  --rootless          Use a user-local install profile for Linux/WSL
  --dry-run           Print actions without executing
  -h, --help          Show this help
USAGE
}

log() {
  printf '[setup] %s\n' "$*"
}

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run: $*"
  else
    eval "$*"
  fi
}

detect_platform() {
  if [[ "${OSTYPE:-}" == darwin* ]]; then
    echo "macos"
    return
  fi

  if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    echo "wsl"
    return
  fi

  if [[ -r /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    echo "wsl"
    return
  fi

  echo "linux"
}

has_sudo_access() {
  if ! command -v sudo >/dev/null 2>&1; then
    return 1
  fi

  sudo -n true >/dev/null 2>&1
}

has_apt_get() {
  command -v apt-get >/dev/null 2>&1
}

rootless_brew_prefix() {
  printf '%s\n' "${DOTFILES_ROOTLESS_BREW_PREFIX:-$HOME/.linuxbrew}"
}

rootless_brew_bin() {
  printf '%s/bin/brew\n' "$(rootless_brew_prefix)"
}

activate_brew_shellenv() {
  local brew_bin="$1"

  [[ "$DRY_RUN" -eq 0 ]] || return 0
  [[ -x "$brew_bin" ]] || return 0

  eval "$("$brew_bin" shellenv)"
}

ensure_rootless_homebrew() {
  local brew_prefix brew_repo brew_bin

  brew_prefix="$(rootless_brew_prefix)"
  brew_repo="$brew_prefix/Homebrew"
  brew_bin="$(rootless_brew_bin)"

  if [[ -x "$brew_bin" ]]; then
    return 0
  fi

  run "mkdir -p '$brew_repo' '$brew_prefix/bin'"

  if [[ ! -d "$brew_repo/.git" ]]; then
    run "git clone https://github.com/Homebrew/brew '$brew_repo'"
  fi

  if [[ ! -e "$brew_bin" ]]; then
    run "ln -sf '../Homebrew/bin/brew' '$brew_bin'"
  fi
}

ensure_bun_tap() {
  local brew_bin="${1:-brew}"
  run "'$brew_bin' tap oven-sh/bun"
}

configure_macos_sudo_touchid() {
  local pam_file="/etc/pam.d/sudo"
  local touchid_line="auth       sufficient     pam_tid.so"
  local tmp_file

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run: ensure Touch ID is configured for sudo in $pam_file"
    return 0
  fi

  if [[ ! -f "$pam_file" ]]; then
    log "sudo pam config not found at $pam_file. Skipping Touch ID setup."
    return 0
  fi

  if sudo grep -Eq '^auth[[:space:]]+sufficient[[:space:]]+pam_tid\\.so' "$pam_file"; then
    log "Touch ID already enabled for sudo."
    return 0
  fi

  tmp_file="$(mktemp)"
  if ! sudo cp "$pam_file" "$tmp_file"; then
    log "Failed to copy $pam_file. Cannot enable Touch ID."
    rm -f "$tmp_file"
    return 1
  fi

  if sudo sh -c "printf '%s\n' \"$touchid_line\" | cat - \"$tmp_file\" > \"$tmp_file.new\""; then
    if sudo mv "$tmp_file.new" "$pam_file"; then
      log "Enabled Touch ID for sudo in $pam_file."
    else
      log "Failed to install updated sudo pam config."
      sudo rm -f "$tmp_file.new"
      sudo rm -f "$tmp_file"
      return 1
    fi
  else
    log "Failed to prepare Touch ID sudo pam config."
    sudo rm -f "$tmp_file" "$tmp_file.new"
    return 1
  fi

  sudo rm -f "$tmp_file"
}

configure_system() {
  case "$TARGET" in
    macos)
      configure_macos_sudo_touchid
      ;;
    linux|wsl)
      log "No system configuration steps for $TARGET ($SYSTEM_PROFILE) yet."
      ;;
  esac
}

install_brew_formulae() {
  local brew_bin="$1"
  local formula_file="$2"
  local formula

  if [[ ! -f "$formula_file" ]]; then
    log "Missing formula list: $formula_file"
    return 1
  fi

  while IFS= read -r formula || [[ -n "$formula" ]]; do
    formula="${formula%%#*}"
    formula="$(printf '%s' "$formula" | xargs)"
    [[ -z "$formula" ]] && continue
    log "Installing $formula with verbose output."
    run "'$brew_bin' install -v '$formula'"
  done < "$formula_file"
}

preferred_zsh_bin() {
  local local_zsh

  local_zsh="$(rootless_brew_prefix)/bin/zsh"
  if [[ -x "$local_zsh" ]]; then
    printf '%s\n' "$local_zsh"
    return 0
  fi

  if command -v zsh >/dev/null 2>&1; then
    command -v zsh
    return 0
  fi

  printf '%s\n' "$local_zsh"
}

managed_zsh_shim() {
  printf '%s/.local/bin/zsh\n' "$HOME"
}

enter_configured_zsh_now() {
  local zsh_shim

  [[ "$DRY_RUN" -eq 0 ]] || return 0
  [[ -t 0 && -t 1 ]] || return 0
  [[ "$TARGET" == "linux" || "$TARGET" == "wsl" ]] || return 0

  zsh_shim="$(managed_zsh_shim)"
  [[ -x "$zsh_shim" ]] || return 0

  if [[ -n "${ZSH_VERSION:-}" ]]; then
    return 0
  fi

  log "Starting zsh for this session."
  exec "$zsh_shim" -l
}

append_managed_block() {
  local target_file="$1"
  local block_name="$2"
  local block_content="$3"
  local start_marker="# >>> dotfiles $block_name >>>"
  local end_marker="# <<< dotfiles $block_name <<<"

  run "mkdir -p '$(dirname "$target_file")'"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run: update '$target_file' with managed block '$block_name'"
    return 0
  fi

  touch "$target_file"

  TARGET_FILE="$target_file" \
  BLOCK_NAME="$block_name" \
  BLOCK_CONTENT="$block_content" \
  python3 - <<'PY'
import os
from pathlib import Path

path = Path(os.environ["TARGET_FILE"])
block_name = os.environ["BLOCK_NAME"]
block_content = os.environ["BLOCK_CONTENT"].rstrip("\n")
start = f"# >>> dotfiles {block_name} >>>"
end = f"# <<< dotfiles {block_name} <<<"

existing = path.read_text() if path.exists() else ""
managed = f"{start}\n{block_content}\n{end}\n"

lines = existing.splitlines()
out = []
i = 0
replaced = False

while i < len(lines):
    if lines[i] == start:
        i += 1
        while i < len(lines) and lines[i] != end:
            i += 1
        if i < len(lines) and lines[i] == end:
            i += 1
        if out and out[-1] != "":
            out.append("")
        out.extend(managed.rstrip("\n").splitlines())
        replaced = True
        continue
    out.append(lines[i])
    i += 1

if not replaced:
    if out and out[-1] != "":
        out.append("")
    out.extend(managed.rstrip("\n").splitlines())

path.write_text("\n".join(out).rstrip("\n") + "\n")
PY
}

configure_linuxbrew_shellenv() {
  local brew_bin profile_file profile_block

  brew_bin="$(rootless_brew_bin)"
  profile_file="$HOME/.profile"

  if [[ ! -x "$brew_bin" && "$DRY_RUN" -ne 1 ]]; then
    return 0
  fi

  profile_block=$(printf '%s\n' \
    "if [ -x \"$brew_bin\" ]; then" \
    "  eval \"\$(\"$brew_bin\" shellenv)\"" \
    "fi")

  append_managed_block "$profile_file" "linuxbrew-shellenv" "$profile_block"
}

configure_zsh_shell() {
  local zsh_bin zsh_shim profile_file profile_block current_shell chsh_cmd

  zsh_bin="$(preferred_zsh_bin)"
  zsh_shim="$(managed_zsh_shim)"
  profile_file="$HOME/.profile"

  if [[ ! -x "$zsh_bin" && "$DRY_RUN" -ne 1 ]]; then
    log "zsh not found at $zsh_bin. Skipping shell switch."
    return 0
  fi

  run "mkdir -p '${zsh_shim%/*}'"
  run "ln -sfn '$zsh_bin' '$zsh_shim'"
  log "Created zsh shortcut at $zsh_shim."

  current_shell="$(getent passwd "$USER" | cut -d: -f7 2>/dev/null || printf '%s' "${SHELL:-}")"
  if [[ "$current_shell" == "$zsh_bin" || "$current_shell" == "$zsh_shim" ]]; then
    log "Login shell already points to zsh."
  elif command -v chsh >/dev/null 2>&1; then
    chsh_cmd="chsh -s '$zsh_bin'"

    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "dry-run: attempt login shell change with: $chsh_cmd"
    elif chsh -s "$zsh_bin" >/dev/null 2>&1; then
      log "Login shell changed to $zsh_bin."
      return 0
    else
      log "Could not change login shell automatically. Installing shell fallback in ~/.profile."
    fi
  else
    log "chsh is not available. Installing shell fallback in ~/.profile."
  fi

  profile_block=$(printf '%s\n' \
    "if [ -x \"$zsh_shim\" ] && [ -z \"\${ZSH_VERSION:-}\" ] && [ \"\${SHELL:-}\" != \"$zsh_bin\" ]; then" \
    "  case \"\$-\" in" \
    "    *i*) exec \"$zsh_shim\" -l ;;" \
    "  esac" \
    "fi")

  append_managed_block "$profile_file" "rootless-zsh" "$profile_block"
  log "Interactive logins will now jump into $zsh_bin via ~/.profile."
  log "To start it in the current session, run: $zsh_shim -l"
}

install_macos() {
  local formula_file="$INSTALL_DIR/tool-formulae.txt"
  if ! command -v brew >/dev/null 2>&1 && [[ "$DRY_RUN" -ne 1 ]]; then
    log "Homebrew not found. Install brew first, then rerun setup."
    return 1
  fi

  ensure_bun_tap brew
  run "brew install -v git"
  install_brew_formulae brew "$formula_file"
  run "brew install -v jandedobbeleer/oh-my-posh/oh-my-posh"
}

install_wsl() {
  install_apt_linux "WSL"
  install_linuxbrew_cli_tools
}

install_apt_linux() {
  local platform_label="$1"
  local pkg_file="$INSTALL_DIR/wsl-packages.txt"

  if ! command -v apt-get >/dev/null 2>&1 && [[ "$DRY_RUN" -ne 1 ]]; then
    log "apt-get not found. This $platform_label setup assumes Ubuntu/Debian."
    return 1
  fi

  if [[ ! -f "$pkg_file" ]]; then
    log "Missing package list: $pkg_file"
    return 1
  fi

  run "sudo apt-get update"
  run "xargs -a '$pkg_file' sudo apt-get install -y"
}

install_linux() {
  install_apt_linux "Linux"
  install_linuxbrew_cli_tools
}

install_linuxbrew_cli_tools() {
  local formula_file="$INSTALL_DIR/tool-formulae.txt"
  local brew_bin

  if [[ ! -f "$formula_file" ]]; then
    log "Missing shared tool formula list: $formula_file"
    return 1
  fi

  ensure_rootless_homebrew
  brew_bin="$(rootless_brew_bin)"
  activate_brew_shellenv "$brew_bin"
  ensure_bun_tap "$brew_bin"
  install_brew_formulae "$brew_bin" "$formula_file"
  activate_brew_shellenv "$brew_bin"
}

install_rootless_linux() {
  local brew_bin

  install_linuxbrew_cli_tools

  if command -v zsh >/dev/null 2>&1; then
    log "zsh is already available at $(command -v zsh). Skipping Linuxbrew zsh install."
    return 0
  fi

  brew_bin="$(rootless_brew_bin)"
  log "Installing zsh last with verbose output. This can take a while on older Linux systems."
  run "'$brew_bin' install -v zsh"
}

check_common_tools() {
  local tools_file="$INSTALL_DIR/common-tools.txt"
  local missing=()

  if [[ "$TARGET" == "linux" || "$TARGET" == "wsl" ]]; then
    tools_file="$INSTALL_DIR/common-tools-rootless.txt"
  elif [[ "$ROOTLESS" -eq 1 ]]; then
    tools_file="$INSTALL_DIR/common-tools-rootless.txt"
  fi

  [[ -f "$tools_file" ]] || return 0

  while IFS= read -r tool || [[ -n "$tool" ]]; do
    tool="${tool%%#*}"
    tool="$(printf '%s' "$tool" | xargs)"
    [[ -z "$tool" ]] && continue

    if ! command -v "$tool" >/dev/null 2>&1; then
      missing+=("$tool")
    fi
  done < "$tools_file"

  if [[ "${#missing[@]}" -eq 0 ]]; then
    log "All commands in common-tools manifest are available."
    return 0
  fi

  log "Missing commands from common-tools manifest:"
  for cmd in "${missing[@]}"; do
    log "  - $cmd"
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --only)
      ONLY="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --rootless)
      ROOTLESS=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

PLATFORM="$(detect_platform)"
TARGET="${ONLY:-$PLATFORM}"

if [[ "$ROOTLESS" -eq 0 && ( "$TARGET" == "linux" || "$TARGET" == "wsl" ) ]]; then
  if ! has_apt_get || ! has_sudo_access; then
    ROOTLESS=1
    log "No usable sudo-based package path detected. Falling back to rootless install."
  fi
fi

case "$TARGET" in
  macos|linux|wsl) ;;
  *)
    log "Invalid --only value: $TARGET"
    usage
    exit 1
    ;;
esac

log "Detected platform: $PLATFORM"
log "Target platform: $TARGET"
if [[ "$ROOTLESS" -eq 1 ]]; then
  log "Install profile: rootless"
fi
log "System profile: $SYSTEM_PROFILE"

case "$TARGET" in
  macos)
    if [[ "$ROOTLESS" -eq 1 ]]; then
      log "Rootless profile is only supported for linux and wsl."
      exit 1
    fi
    install_macos
    ;;
  wsl)
    if [[ "$ROOTLESS" -eq 1 ]]; then
      install_rootless_linux
    else
      install_wsl
    fi
    ;;
  linux)
    if [[ "$ROOTLESS" -eq 1 ]]; then
      install_rootless_linux
    else
      install_linux
    fi
    ;;
esac

configure_system

check_common_tools

if [[ "$TARGET" == "linux" || "$TARGET" == "wsl" ]]; then
  configure_linuxbrew_shellenv
  configure_zsh_shell
fi

log "Done."

enter_configured_zsh_now
